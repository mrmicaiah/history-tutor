{
  "name": "history-tutor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit -p worker/tsconfig.json && tsc --noEmit -p pages/tsconfig.json && tsc --noEmit -p functions/tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "db:migrate:local": "wrangler d1 migrations apply history_tutor_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply history_tutor_db --remote",
    "build:pages": "NODE_ENV=production node pages/build.mjs",
    "watch:pages": "node pages/build.mjs --watch",
    "dev:pages": "wrangler pages dev pages/public --port 8788 --binding WORKER_URL=http://localhost:8787"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.15.2",
    "@cloudflare/workers-types": "^4.20250109.0",
    "@vitest/coverage-v8": "^4.1.5",
    "esbuild": "^0.28.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.5",
    "wrangler": "^4.87.0"
  }
}
